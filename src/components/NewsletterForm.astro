---
import { SITE } from '../data/site';
interface Props { variant?: 'band' | 'page'; source?: string }
const { variant = 'band', source = 'band' } = Astro.props;
const id = 'nl-' + variant;
---
<form class={`nlform nl-${variant}`} method="post" action="/b2b/newsletter.php" id={id}>
  <div class="nl-row">
    <label class="sr" for={`${id}-first`}>Imię *</label>
    <input id={`${id}-first`} name="first_name" required maxlength="80" placeholder="Imię *" autocomplete="given-name" />
    <span class="nl-extra" hidden={variant === "band"}><label class="sr" for={`${id}-last`}>Nazwisko</label><input id={`${id}-last`} name="last_name" maxlength="80" placeholder="Nazwisko" autocomplete="family-name" /></span>
    <label class="sr" for={`${id}-email`}>E-mail *</label>
    <input id={`${id}-email`} name="email" type="email" required maxlength="160" placeholder="E-mail *" autocomplete="email" />
    <span class="nl-extra" hidden={variant === "band"}><label class="sr" for={`${id}-company`}>Nazwa firmy</label><input id={`${id}-company`} name="company" maxlength="160" placeholder="Nazwa firmy" autocomplete="organization" /><label class="sr" for={`${id}-phone`}>Telefon</label><input id={`${id}-phone`} name="phone" type="tel" maxlength="40" placeholder="Telefon" autocomplete="tel" /></span>
    <button class="btn btn-gold" type="submit">Zapisz się</button>
  </div>
  <label class="nl-chk"><input type="checkbox" name="consent" value="1" required /> <span>Zgadzam się na otrzymywanie newslettera ePerfumeria ({SITE.company}) e-mailem. Mogę się wypisać w każdej chwili (<a href="/polityka-prywatnosci/">Polityka prywatności</a>).</span></label>
  <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <input type="hidden" name="ts" value="0" />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="lang" value="pl" />
  <input type="hidden" name="browser_lang" value="" />
</form>
<script is:inline define:vars={{ id }}>
  var f = document.getElementById(id);
  if (f) {
    f.ts.value = Date.now();
    f.browser_lang.value = (navigator.languages && navigator.languages[0]) || navigator.language || '';
    var otworz = function () { f.querySelectorAll('.nl-extra[hidden]').forEach(function (e) { e.hidden = false; }); };
    f.addEventListener('focusin', otworz); f.addEventListener('input', otworz);
    f.addEventListener('submit', function () { try { sessionStorage.setItem('nl_email', f.email.value.trim()); } catch (x) {} });
  }
</script>
